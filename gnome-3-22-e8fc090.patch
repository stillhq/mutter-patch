         keyboard_send_modifiers (keyboard, resource, serial);
     }
 }
@@ -837,16 +833,14 @@ meta_wayland_keyboard_set_focus (MetaWaylandKeyboard *keyboard,
   if (keyboard->focus_surface != NULL)
     {
       struct wl_resource *resource;
